---
// Drop a real or generated portrait at src/assets/portrait.jpg (or .png / .webp)
// and it replaces the placeholder automatically.
interface Props { class?: string; caption?: boolean }
const { class: cls = '', caption = true } = Astro.props;
const found = import.meta.glob<string>('/src/assets/portrait.{jpg,jpeg,png,webp}', { eager: true, query: '?url', import: 'default' });
const src = Object.values(found)[0];
---

<figure class:list={['relative overflow-hidden rounded-[2rem] bg-navy-soft', cls]}>
  {src ? (
    <img src={src} alt="Dr. Naomi Castellan, wearing a charcoal knit blazer, smiling at the camera" class="h-full w-full object-cover" loading="eager" />
  ) : (
    <svg viewBox="0 0 400 500" class="h-full w-full" role="img" aria-label="Portrait placeholder for Dr. Naomi Castellan">
      <defs>
        <linearGradient id="pg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#1a2a4a" /><stop offset="1" stop-color="#0f1b33" /></linearGradient>
        <radialGradient id="pglow" cx="0.7" cy="0.2" r="0.7"><stop offset="0" stop-color="#b08a4a" stop-opacity="0.45" /><stop offset="1" stop-color="#b08a4a" stop-opacity="0" /></radialGradient>
      </defs>
      <rect width="400" height="500" fill="url(#pg)" /><rect width="400" height="500" fill="url(#pglow)" />
      <path d="M0 500 C20 380 110 340 200 340 C290 340 380 380 400 500 Z" fill="#7a2e2e" opacity="0.92" />
      <path d="M150 340 L200 410 L250 340" fill="none" stroke="#d3b373" stroke-width="3" opacity="0.7" />
      <rect x="178" y="285" width="44" height="64" rx="20" fill="#d3b373" opacity="0.85" />
      <ellipse cx="200" cy="215" rx="68" ry="82" fill="#d3b373" opacity="0.9" />
      <path d="M128 205 C124 130 170 110 205 112 C250 114 282 150 272 215 C262 170 230 150 200 152 C170 154 140 168 128 205Z" fill="#14213a" />
    </svg>
  )}
  {caption && !src && <figcaption class="absolute bottom-3 left-3 rounded-full bg-navy/70 px-3 py-1 text-[0.65rem] uppercase tracking-widest text-bone/80">Portrait placeholder</figcaption>}
</figure>
