---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { books } from '../data/site';

const start = [
  ['Your team is overwhelmed by noise', 'The Quiet Team'],
  ['Meetings and remote work feel thin', 'Present Tense'],
  ['You lead many teams or a whole company', 'Trust at Scale'],
];
---

<Base title="Books" description="The Castellan Method book series: The Quiet Team, Present Tense and Trust at Scale. Read them in any order.">
  <section class="section !pb-8">
    <div class="wrap max-w-4xl">
      <p class="eyebrow reveal">The series</p>
      <h1 class="display reveal mt-4">Three books. One method. Start anywhere.</h1>
      <p class="lede reveal mt-6 text-charcoal/80">Each book stands alone and builds on the same idea. Read them in order, or start with the one that matches your week.</p>
      <p class="reveal mt-4 text-sm font-semibold text-oxblood-deep">Best-selling series · 180,000 copies (demonstration figure)</p>
    </div>
  </section>

  <section class="section !pt-6">
    <div class="wrap grid gap-8 md:grid-cols-3">
      {books.map((b) => (
        <article class="reveal flex flex-col">
          <div class:list={['flex aspect-[2/3] flex-col justify-between rounded-md p-7 text-bone shadow-2xl transition hover:-translate-y-1', b.accent === 'navy' && 'bg-navy', b.accent === 'oxblood' && 'bg-oxblood', b.accent === 'charcoal' && 'bg-charcoal']}>
            <div><p class="text-[0.65rem] uppercase tracking-[0.25em] text-brass-light">Book {b.n} of 3</p><div class="mt-3 h-px w-12 bg-brass"></div></div>
            <div><h2 class="font-serif text-4xl leading-none">{b.title}</h2><p class="mt-3 text-sm text-bone/75">{b.sub}</p></div>
            <p class="text-xs uppercase tracking-[0.2em] text-bone/60">Naomi Castellan</p>
          </div>
          <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-charcoal/50">{b.year}</p>
          <p class="mt-1 text-charcoal/80">{b.blurb}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {['Hardcover', 'eBook', 'Audiobook'].map((f) => <button type="button" data-demo="Demo site: there is no checkout. This would go to a bookseller." class="btn btn-ghost !px-4 !py-2 !text-sm">{f}</button>)}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-bone-deep/50">
    <div class="wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal"><p class="eyebrow">Where to begin</p><h2 class="h2 mt-4">Pick the one that fits.</h2></div>
      <ul class="reveal divide-y divide-charcoal/15 border-y border-charcoal/15">
        {start.map(([when, book]) => <li class="flex flex-wrap items-baseline justify-between gap-2 py-5"><span class="text-lg">{when}</span><span class="font-serif text-xl text-oxblood">{book}</span></li>)}
      </ul>
    </div>
  </section>

  <Cta heading="Prefer to talk it through?" text="Bring your questions about the books, or about your team, to a free introductory call." />
</Base>
