---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';
import insightsIndex from '../../data/insights-index.json';

const idx = insightsIndex as Record<string, { readingMinutes: number }>;
const articles = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const themes = [...new Set(articles.map((a) => a.data.theme))];
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title="Insights" description="Articles on team confidence, leading through technology, and executive practice.">
  <section class="section !pb-6">
    <div class="wrap max-w-4xl">
      <p class="eyebrow reveal">Insights</p>
      <h1 class="display reveal mt-4">Notes for leaders of teams.</h1>
    </div>
  </section>

  <section class="section !pt-4">
    <div class="wrap">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by theme" id="filters">
          <button type="button" data-theme="" aria-pressed="true" class="chip">All</button>
          {themes.map((t) => <button type="button" data-theme={t} aria-pressed="false" class="chip">{t}</button>)}
        </div>
        <div class="field w-full sm:w-72">
          <label for="q" class="sr-only">Search articles</label>
          <input id="q" type="search" placeholder="Search articles" autocomplete="off" />
        </div>
      </div>

      <ul id="list" class="mt-10 grid gap-6 md:grid-cols-2">
        {articles.map((a) => (
          <li data-theme={a.data.theme} data-text={`${a.data.title} ${a.data.summary} ${a.data.tags.join(' ')}`.toLowerCase()}>
            <a href={url(`/insights/${a.id}/`)} class="card group flex h-full flex-col no-underline">
              <p class="eyebrow">{a.data.theme}</p>
              <h2 class="mt-3 text-2xl group-hover:text-oxblood">{a.data.title}</h2>
              <p class="mt-3 text-charcoal/75">{a.data.summary}</p>
              <p class="mt-auto pt-5 text-xs text-charcoal/55">{fmt(a.data.date)} · {idx[a.id]?.readingMinutes ?? 3} min read</p>
            </a>
          </li>
        ))}
      </ul>
      <p id="none" hidden class="mt-10 text-lg text-charcoal/70">No articles match. Try another theme or search term.</p>
    </div>
  </section>

  <style is:global>
    .chip { border: 1.5px solid rgba(30,35,33,.25); border-radius: 999px; padding: .5rem 1rem; font-size: .85rem; font-weight: 600; cursor: pointer; transition: background .2s, color .2s; }
    .chip:hover { background: var(--color-bone-deep); }
    .chip[aria-pressed='true'] { background: var(--color-navy); color: var(--color-bone); border-color: var(--color-navy); }
  </style>

  <script is:inline>
    (function () {
      var theme = '', term = '';
      var items = document.querySelectorAll('#list li');
      var none = document.getElementById('none');
      function apply() {
        var shown = 0;
        items.forEach(function (li) {
          var ok = (!theme || li.dataset.theme === theme) && (!term || li.dataset.text.indexOf(term) > -1);
          li.hidden = !ok; if (ok) shown++;
        });
        none.hidden = shown > 0;
      }
      document.getElementById('filters').addEventListener('click', function (e) {
        var b = e.target.closest('button'); if (!b) return;
        theme = b.dataset.theme;
        document.querySelectorAll('#filters button').forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        apply();
      });
      document.getElementById('q').addEventListener('input', function (e) { term = e.target.value.trim().toLowerCase(); apply(); });
    })();
  </script>
</Base>
