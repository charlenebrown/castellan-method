---
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { getCollection, render } from 'astro:content';
import { url } from '../../lib/url';
import insightsIndex from '../../data/insights-index.json';

export async function getStaticPaths() {
  const articles = await getCollection('insights');
  return articles.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const idx = insightsIndex as Record<string, { readingMinutes: number; related: string[] }>;
const meta = idx[entry.id];
const all = await getCollection('insights');
const related = (meta?.related ?? []).map((s) => all.find((a) => a.id === s)).filter(Boolean);
const date = entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="section !pb-12">
    <div class="wrap">
      <a href={url('/insights/')} class="link-arrow text-sm">← All insights</a>
      <p class="eyebrow mt-8">{entry.data.theme}</p>
      <h1 class="display mt-4 max-w-4xl" style="font-size: clamp(2.2rem, 5vw, 3.8rem)">{entry.data.title}</h1>
      <p class="mt-5 text-sm text-charcoal/65">{date} · {meta?.readingMinutes ?? 3} min read · By Dr. Naomi Castellan</p>
      <div class="rule my-10 max-w-2xl"></div>
      <div class="prose-c"><Content /></div>
      <ul class="mt-10 flex flex-wrap gap-2" aria-label="Tags">
        {entry.data.tags.map((t) => <li class="rounded-full bg-bone-deep px-3 py-1 text-xs font-semibold">{t}</li>)}
      </ul>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section bg-bone-deep/50 !py-14">
      <div class="wrap">
        <h2 class="text-3xl">Keep reading</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {related.map((r) => (
            <a href={url(`/insights/${r!.id}/`)} class="card group no-underline">
              <p class="eyebrow">{r!.data.theme}</p>
              <h3 class="mt-3 text-xl group-hover:text-oxblood">{r!.data.title}</h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <Cta heading="Want help applying this to your team?" />
</Base>
