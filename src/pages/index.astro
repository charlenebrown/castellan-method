---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import PressStrip from '../components/PressStrip.astro';
import Cta from '../components/Cta.astro';
import { getCollection } from 'astro:content';
import { stats, paths, method, testimonials, books, episodes, faqs, brand } from '../data/site';
import { url } from '../lib/url';
import insightsIndex from '../data/insights-index.json';

const articles = (await getCollection('insights')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const idx = insightsIndex as Record<string, { readingMinutes: number }>;
---

<Base title="Home" dark>
  <!-- Hero -->
  <section class="on-dark relative overflow-hidden bg-navy text-bone">
    <div class="pointer-events-none absolute -right-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-oxblood/30 blur-3xl" aria-hidden="true"></div>
    <div class="wrap relative grid items-center gap-12 pb-20 pt-12 md:pb-28 md:pt-20 lg:grid-cols-[1.25fr_1fr]">
      <div>
        <p class="eyebrow reveal">Executive consulting · New York &amp; Boston</p>
        <h1 class="display reveal mt-5">Lead the people. <span class="italic text-brass-light">Let the tech follow.</span></h1>
        <p class="lede reveal mt-6 text-bone/80">
          I help executive teams stay confident and connected while technology reshapes how they work. Research-led, direct, and built for real calendars.
        </p>
        <div class="reveal mt-9 flex flex-wrap gap-3">
          <button type="button" data-apply class="btn btn-brass">Apply for consulting</button>
          <a href={url('/book-a-call/')} class="btn btn-ghost">Book a free call</a>
        </div>
        <p class="reveal mt-8 text-sm text-bone/60">PhD, Organizational Psychology · Professor in New York · Best-selling author · Podcast host</p>
      </div>
      <div class="reveal mx-auto w-full max-w-sm lg:max-w-none">
        <Portrait class="aspect-[4/5] shadow-2xl ring-1 ring-bone/10" />
      </div>
    </div>
  </section>

  <PressStrip />

  <!-- Stats -->
  <section class="section !pb-8">
    <div class="wrap">
      <dl class="grid grid-cols-2 gap-y-10 md:grid-cols-4">
        {stats.map((s) => (
          <div class="reveal border-l border-charcoal/15 pl-5">
            <dt class="order-2 mt-1 text-sm text-charcoal/65">{s.label}</dt>
            <dd class="font-serif text-4xl md:text-5xl">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Problem / method -->
  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-[1fr_1.2fr]">
      <div class="reveal">
        <p class="eyebrow">The problem</p>
        <h2 class="h2 mt-4">More tools. Less togetherness.</h2>
        <p class="lede mt-6 text-charcoal/80">
          Teams have never been more connected, or more fragmented. Attention splits across channels, meetings multiply, and the quiet people stop speaking. Confidence erodes without anyone deciding it should.
        </p>
        <p class="mt-5 font-serif text-2xl italic text-oxblood">{brand.principle}</p>
      </div>
      <ol class="grid gap-5">
        {method.map((m) => (
          <li class="card reveal flex gap-6">
            <span class="font-serif text-4xl text-brass">{m.n}</span>
            <div>
              <h3 class="text-2xl">{m.title}</h3>
              <p class="mt-2 text-charcoal/75">{m.blurb}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Paths -->
  <section class="section bg-bone-deep/50">
    <div class="wrap">
      <div class="reveal max-w-2xl">
        <p class="eyebrow">Work with me</p>
        <h2 class="h2 mt-4">Three ways to work together. One for larger organizations.</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {paths.map((p) => (
          <article class="card reveal flex flex-col">
            <p class="eyebrow">{p.kicker}</p>
            <h3 class="mt-3 text-2xl">{p.title}</h3>
            <p class="mt-3 text-charcoal/75">{p.blurb}</p>
            <ul class="mt-5 grid gap-2 text-sm">
              {p.points.map((pt) => <li class="flex gap-2"><span class="text-brass" aria-hidden="true">◆</span>{pt}</li>)}
            </ul>
            <button type="button" data-apply={p.key === 'personal' ? 'individual' : p.key === 'team' ? 'team' : undefined} class="link-arrow mt-auto self-start pt-6 text-left">Apply for this →</button>
          </article>
        ))}
      </div>
      <div class="reveal mt-8 flex flex-col items-start justify-between gap-4 rounded-3xl bg-navy p-8 text-bone md:flex-row md:items-center">
        <div class="on-dark">
          <p class="eyebrow">For organizations</p>
          <p class="mt-2 font-serif text-2xl">Leading a larger company or institution?</p>
        </div>
        <a href={url('/organizations/')} class="btn btn-brass">Request a briefing</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section">
    <div class="wrap grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <Portrait class="reveal aspect-[5/6] max-w-md" caption={false} />
      <div class="reveal">
        <p class="eyebrow">Meet Dr. Castellan</p>
        <h2 class="h2 mt-4">A professor in New York. An advisor in Boston.</h2>
        <p class="lede mt-6 text-charcoal/80">
          Naomi Castellan spent two decades studying how groups think, decide and trust each other. Now she brings that research into leadership teams that cannot afford to guess. She teaches organizational psychology in New York and works with executive teams in Boston and beyond.
        </p>
        <a href={url('/about/')} class="link-arrow mt-8 inline-block">Read her story</a>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <section class="on-dark section bg-navy text-bone">
    <div class="wrap">
      <p class="eyebrow reveal">What leaders say</p>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {testimonials.map((t) => (
          <figure class="reveal flex flex-col rounded-3xl border border-bone/15 p-7">
            <blockquote class="font-serif text-xl leading-snug">“{t.quote}”</blockquote>
            <figcaption class="mt-auto pt-6 text-sm"><strong class="block text-brass-light">{t.name}</strong><span class="text-bone/65">{t.role}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Media + books -->
  <section class="section">
    <div class="wrap grid gap-14 lg:grid-cols-2">
      <div class="reveal">
        <p class="eyebrow">The podcast</p>
        <h2 class="h2 mt-4">The Connected Leader</h2>
        <p class="mt-4 text-charcoal/75">Over six million listens. Conversations with executives, researchers and operators about leading people well in a digital age.</p>
        <ul class="mt-6 divide-y divide-charcoal/10 border-y border-charcoal/10">
          {episodes.slice(0, 3).map((e) => (
            <li class="flex items-center justify-between gap-4 py-4">
              <div><p class="text-xs font-semibold uppercase tracking-wider text-charcoal/50">Episode {e.n}</p><p class="font-serif text-lg">{e.title}</p></div>
              <span class="shrink-0 text-sm text-charcoal/60">{e.length}</span>
            </li>
          ))}
        </ul>
        <a href={url('/media/')} class="link-arrow mt-6 inline-block">All episodes and video</a>
      </div>
      <div class="reveal">
        <p class="eyebrow">The book series</p>
        <h2 class="h2 mt-4">Three books. Read them in any order.</h2>
        <div class="mt-6 flex gap-4">
          {books.map((b) => (
            <div class:list={['flex aspect-[2/3] flex-1 flex-col justify-between rounded-lg p-4 text-bone shadow-xl', b.accent === 'navy' && 'bg-navy', b.accent === 'oxblood' && 'bg-oxblood', b.accent === 'charcoal' && 'bg-charcoal']}>
              <span class="text-[0.6rem] uppercase tracking-[0.2em] text-brass-light">Book {b.n}</span>
              <span class="font-serif text-lg leading-tight sm:text-xl">{b.title}</span>
            </div>
          ))}
        </div>
        <a href={url('/books/')} class="link-arrow mt-6 inline-block">Explore the series</a>
      </div>
    </div>
  </section>

  <!-- Assessment teaser -->
  <section class="section bg-bone-deep/50">
    <div class="wrap grid items-center gap-10 md:grid-cols-[1.3fr_1fr]">
      <div class="reveal">
        <p class="eyebrow">Two-minute check</p>
        <h2 class="h2 mt-4">How cohesive is your team right now?</h2>
        <p class="lede mt-5 text-charcoal/80">Eight honest questions. You get a score across Quiet, Present and Trust, plus the one place to start.</p>
      </div>
      <div class="reveal md:text-right"><a href={url('/cohesion-check/')} class="btn btn-primary">Take the Team Cohesion Check</a></div>
    </div>
  </section>

  <!-- Insights -->
  <section class="section">
    <div class="wrap">
      <div class="reveal flex flex-wrap items-end justify-between gap-4">
        <div><p class="eyebrow">Insights</p><h2 class="h2 mt-4">Recent writing</h2></div>
        <a href={url('/insights/')} class="link-arrow">All articles</a>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {articles.map((a) => (
          <a href={url(`/insights/${a.id}/`)} class="card reveal group flex flex-col no-underline">
            <p class="eyebrow">{a.data.theme}</p>
            <h3 class="mt-3 text-xl group-hover:text-oxblood">{a.data.title}</h3>
            <p class="mt-3 text-sm text-charcoal/70">{a.data.summary}</p>
            <p class="mt-auto pt-5 text-xs text-charcoal/55">{idx[a.id]?.readingMinutes ?? 3} min read</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section bg-bone-deep/50">
    <div class="wrap grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
      <div class="reveal"><p class="eyebrow">Questions</p><h2 class="h2 mt-4">Before you reach out</h2></div>
      <div class="reveal divide-y divide-charcoal/15 border-y border-charcoal/15">
        {faqs.map((f) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-serif text-xl">
              {f.q}<span class="text-2xl text-oxblood transition group-open:rotate-45" aria-hidden="true">+</span>
            </summary>
            <p class="mt-3 max-w-xl text-charcoal/75">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <Cta />
</Base>
