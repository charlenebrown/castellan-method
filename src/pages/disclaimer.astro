---
import Base from '../layouts/Base.astro';
---

<Base title="Disclaimer" description="This is a fictional demonstration website.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="display mt-4" style="font-size: clamp(2.2rem, 5vw, 3.6rem)">Disclaimer</h1>
      <div class="prose-c mt-10">
        <p><strong>This website is a fictional demonstration.</strong> Dr. Naomi Castellan and The Castellan Method do not exist. Any resemblance to real people or organizations is coincidental.</p>
        <ul>
          <li>The press outlets named are invented and are not real publications.</li>
          <li>Podcast, video and book figures are made up for illustration.</li>
          <li>Testimonials are fictional.</li>
          <li>Portraits, if shown, are generated or placeholder images.</li>
          <li>No booking, purchase or application on this site is real.</li>
        </ul>
        <p>Content on leadership and teams is general information for illustration and is not professional, medical or legal advice.</p>
      </div>
    </div>
  </section>
</Base>
