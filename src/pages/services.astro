---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { paths, method } from '../data/site';
import { url } from '../lib/url';

const rows = [
  ['Who it is for', 'One senior leader', 'A leadership team of 6 to 10', 'Leaders from different companies'],
  ['Format', 'One-to-one, live online or in person', 'Facilitated sessions, on site or online', 'Cohort: two intensives plus monthly sessions'],
  ['Length', '12 weeks', '3 months', 'One quarter, renewable'],
  ['What you leave with', 'A personal leadership plan', 'A team agreement and shared habits', 'A peer circle and practical frameworks'],
  ['How to start', 'Apply, then a free call', 'Apply, then a free call', 'Application and selection call'],
];
---

<Base title="Services" description="Personal advisory, team working sessions and a peer Roundtable, all built on The Castellan Method.">
  <section class="section !pb-8">
    <div class="wrap max-w-4xl">
      <p class="eyebrow reveal">Services</p>
      <h1 class="display reveal mt-4">Three ways to work together.</h1>
      <p class="lede reveal mt-6 text-charcoal/80">Each is built on the same method: Quiet, Present, Trust. Choose by who is in the room.</p>
    </div>
  </section>

  <section class="section !pt-8">
    <div class="wrap grid gap-6 md:grid-cols-3">
      {paths.map((p) => (
        <article class="card reveal flex flex-col">
          <p class="eyebrow">{p.kicker}</p>
          <h2 class="mt-3 text-3xl">{p.title}</h2>
          <p class="mt-4 text-charcoal/75">{p.blurb}</p>
          <ul class="mt-5 grid gap-2 text-sm">
            {p.points.map((pt) => <li class="flex gap-2"><span class="text-brass" aria-hidden="true">◆</span>{pt}</li>)}
          </ul>
          <button type="button" data-apply={p.key === 'personal' ? 'individual' : p.key === 'team' ? 'team' : undefined} class="btn btn-primary mt-auto self-start">Apply</button>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-bone-deep/50">
    <div class="wrap">
      <h2 class="h2 reveal">Compared</h2>
      <div class="reveal mt-8 overflow-x-auto rounded-2xl border border-charcoal/15 bg-[#fbf8f3]">
        <table class="w-full min-w-[40rem] border-collapse text-left text-sm">
          <caption class="sr-only">Comparison of the three formats</caption>
          <thead>
            <tr class="border-b border-charcoal/15">
              <th scope="col" class="p-4"><span class="sr-only">Detail</span></th>
              {paths.map((p) => <th scope="col" class="p-4 font-serif text-lg">{p.title}</th>)}
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="border-b border-charcoal/10 last:border-0">
                <th scope="row" class="p-4 align-top text-xs font-semibold uppercase tracking-wider text-charcoal/60">{r[0]}</th>
                {r.slice(1).map((c) => <td class="p-4 align-top">{c}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h2 reveal">The method behind every format</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {method.map((m) => (
          <div class="reveal border-t-2 border-brass pt-5"><span class="font-serif text-brass">{m.n}</span><h3 class="mt-2 text-2xl">{m.title}</h3><p class="mt-2 text-charcoal/75">{m.blurb}</p></div>
        ))}
      </div>
      <p class="reveal mt-12">Not sure where to start? <a class="link-arrow" href={url('/cohesion-check/')}>Take the two-minute Team Cohesion Check</a>.</p>
    </div>
  </section>

  <Cta />
</Base>
