---
import Base from '../layouts/Base.astro';
---

<Base title="Terms" description="Terms of use for this demonstration site.">
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Legal</p>
      <h1 class="display mt-4" style="font-size: clamp(2.2rem, 5vw, 3.6rem)">Terms of use</h1>
      <div class="prose-c mt-10">
        <p class="rounded-xl bg-brass/15 px-4 py-3 text-base">This is a fictional demonstration site. These terms are placeholders written for the demonstration.</p>
        <h2>Purpose</h2>
        <p>This site shows how a modern consulting website could look and behave. The person, firm, books, podcast, press features, testimonials and statistics are invented.</p>
        <h2>No services are offered</h2>
        <p>Nothing here is an offer to provide services. Bookings, applications and purchases shown on the site are simulations and create no agreement.</p>
        <h2>Content</h2>
        <p>The design and code are the work of their creators. Please do not present this demonstration content as real.</p>
        <h2>No warranty</h2>
        <p>The site is provided as is. The Team Cohesion Check is a self-assessment for illustration and is not professional advice.</p>
        <h2>Changes</h2>
        <p>These terms may change at any time.</p>
      </div>
    </div>
  </section>
</Base>
